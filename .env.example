# ReturnShield Environment Configuration
# Copy this file to .env and fill in real values before running.

# Redis
REDIS_PASSWORD=returnshield_redis_secret

# Security
SECRET_KEY=change-this-in-production-32chars-min
SIM_ADMIN_KEY=sim-admin-key-change-me

# Risk thresholds (optional overrides)
RISK_LOW_THRESHOLD=35
RISK_HIGH_THRESHOLD=65
RISK_SCORE_W_MISTAKEN=0.3

# Simulation caps
SIM_MAX_RPS=50
SIM_MAX_USERS=20
SIM_MAX_DURATION_SECONDS=3600

# Frontend API URL (browser-facing, NOT docker-internal)
VITE_API_URL=http://localhost:8000
